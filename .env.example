# Copy this file to .env and edit values for your remote session.

# Storage. Runpod's persistent partition is /workspace. Caches live in
# ${BENCHMARK_RUNTIME_ROOT}/.cache, results in ${BENCHMARK_RUNTIME_ROOT}/results,
# and temp files in ${BENCHMARK_RUNTIME_ROOT}/tmp.
BENCHMARK_RUNTIME_ROOT=/workspace

# Legacy scratch clusters can use SCRATCH_ROOT instead:
# SCRATCH_ROOT=/scratch/$USER/benchmark-jasper
# Set BENCHMARK_USE_SCRATCH=0 only for project-local development paths.

# Remote build defaults.
# Runpod containers usually do not use environment modules, so leave this empty.
CUDA_MODULE=
PYTORCH_INDEX=https://download.pytorch.org/whl/cu128
JASPER_CUDA_ARCHITECTURES=native
CONSTRAINTS_FILE=constraints-cu128.txt
VENV_DIR=.venv

# vLLM server.
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=token-abc123
VLLM_TP=1
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_MODEL_LEN=32768
VLLM_DTYPE=auto
VLLM_USE_FLASHINFER_SAMPLER=0

# Judge defaults. The benchmark uses the local vLLM server unless you change
# these to another OpenAI-compatible endpoint.
JUDGE_MODEL=meta-llama/Llama-3.1-8B-Instruct
JUDGE_BASE_URL=http://127.0.0.1:8000/v1
JUDGE_API_KEY=token-abc123

# Embeddings. Required for uncached embeddings and --preembed-only.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=

# Optional Hugging Face token for gated model downloads.
# HF_TOKEN=

# Keep local vLLM traffic off proxies.
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1

# Benchmark defaults.
LOCOMO_LOG_EVERY=10
# Number of previous LoCoMo sessions to use as KV encoding context.
LOCOMO_KV_CONTEXT_WINDOW=0
