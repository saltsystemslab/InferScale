# Copy to .env and set credentials for this machine.
# Benchmark, model, sweep, storage, build and server settings come from
# configs/*.json. Qdrant uses QDRANT_URL unless qdrant.url is set in JSON.

# Required for memory benchmarks and fact extraction: the Runpod CPU Qdrant Pod.
QDRANT_URL=https://YOUR_POD_ID-6333.proxy.runpod.net
# Match QDRANT__SERVICE__API_KEY on the Qdrant Pod. Keep this secret out of JSON.
QDRANT_API_KEY=

# Required to populate embedding caches.
# OPENAI_API_KEY=

# Optional credentials for the judge and extraction endpoints in JSON.
JUDGE_LLM_API_KEY=token-abc123
# EXTRACTION_LLM_API_KEY=

# Optional Hugging Face token for gated model downloads.
# HF_TOKEN=
