# Copy this file to .env and edit values for your session.

# Scratch storage. Keep cache, results, temp files, and model artifacts out of
# the repo because benchmark outputs are large.
SCRATCH_ROOT=/scratch/$USER/benchmark-jasper
# Set BENCHMARK_USE_SCRATCH=0 only when you intentionally want project-local
# .cache, results, and tmp directories.
# BENCHMARK_USE_SCRATCH=0
# Optional explicit overrides:
# BENCHMARK_CACHE_ROOT=/path/to/cache
# BENCHMARK_RESULTS_ROOT=/path/to/results
# MEM0_DIR=/path/to/cache/mem0
# TMPDIR=/path/to/tmp

# Remote build defaults.
CUDA_MODULE=
PYTORCH_INDEX=https://download.pytorch.org/whl/cu128
JASPER_CUDA_ARCHITECTURES=native
CONSTRAINTS_FILE=constraints-cu128.txt
VENV_DIR=.venv

# Model used by the in-process answer backends.
LOCOMO_VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
LOCOMO_VLLM_API_KEY=token-abc123
LOCOMO_VLLM_TP=1
LOCOMO_VLLM_GPU_MEMORY_UTILIZATION=0.80
LOCOMO_VLLM_MAX_MODEL_LEN=32768
LOCOMO_VLLM_DTYPE=auto
VLLM_USE_FLASHINFER_SAMPLER=0

# Judge defaults. Start scripts/serve_vllm.sh after answer generation, or point
# these to another OpenAI-compatible endpoint.
JUDGE_MODEL=google/gemma-2-9b-it
JUDGE_BASE_URL=http://127.0.0.1:8000/v1
JUDGE_API_KEY=token-abc123

# Embeddings. Required for uncached embeddings and --preembed-only.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=

# Optional Hugging Face token for gated model downloads.
# HF_TOKEN=

# Keep local vLLM traffic off proxies.
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1

# Benchmark defaults.
LOCOMO_LOG_EVERY=10
# Memory order options: retrieval, turn-index, rank-zigzag, retrieval-reversed.
LOCOMO_MEMORY_ORDER=retrieval
