# Copy this file to .env and edit values for your remote session.

# Storage. By default, scripts keep caches and results on scratch and leave
# only a lightweight .cache symlink in the repo.
BENCHMARK_USE_SCRATCH=1
SCRATCH_ROOT=/scratch/$USER/benchmark-jasper

# Remote build defaults.
CUDA_MODULE=cuda/12.8
PYTORCH_INDEX=https://download.pytorch.org/whl/cu128
JASPER_CUDA_ARCHITECTURES=native
CONSTRAINTS_FILE=constraints-cu128.txt
VENV_DIR=.venv

# vLLM server.
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=token-abc123
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_TP=1
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_MODEL_LEN=32768
VLLM_DTYPE=auto
VLLM_USE_FLASHINFER_SAMPLER=0

# Gemma judge vLLM server. Start with: VLLM_ROLE=judge bash scripts/serve_vllm.sh
JUDGE_VLLM_MODEL=google/gemma-3-12b-it
JUDGE_VLLM_PORT=8001
JUDGE_VLLM_TP=1
JUDGE_VLLM_GPU_MEMORY_UTILIZATION=0.80
JUDGE_MODEL=google/gemma-3-12b-it
JUDGE_BASE_URL=http://127.0.0.1:8001/v1
JUDGE_API_KEY=token-abc123

# Embeddings. Required for uncached embeddings and --preembed-only.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=

# Optional Hugging Face token for gated model downloads.
# HF_TOKEN=

# Keep local vLLM traffic off proxies.
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1

# Benchmark defaults.
LOCOMO_LOG_EVERY=10
