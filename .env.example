# Copy this file to .env and edit values for your remote session.

# Storage. Runpod's persistent partition is /workspace. Caches live in
# ${BENCHMARK_RUNTIME_ROOT}/.cache, results in ${BENCHMARK_RUNTIME_ROOT}/results,
# and temp files in ${BENCHMARK_RUNTIME_ROOT}/tmp.
BENCHMARK_RUNTIME_ROOT=/workspace

# Scratch clusters can use SCRATCH_ROOT instead:
# SCRATCH_ROOT=/scratch/$USER/benchmark-jasper
# Set BENCHMARK_USE_SCRATCH=0 only for project-local development paths.
# Optional explicit overrides:
# BENCHMARK_CACHE_ROOT=/path/to/cache
# BENCHMARK_RESULTS_ROOT=/path/to/results
# MEM0_DIR=/path/to/cache/mem0
# TMPDIR=/path/to/tmp

# Remote build defaults.
# Runpod containers usually do not use environment modules, so leave this empty.
CUDA_MODULE=
PYTORCH_INDEX=https://download.pytorch.org/whl/cu128
JASPER_CUDA_ARCHITECTURES=native
CONSTRAINTS_FILE=constraints-cu128.txt
VENV_DIR=.venv

# Models used by the in-process answer backends. LOCOMO_VLLM_MODEL can be a
# Hugging Face id, local path, or one of: llama, mistral, qwen, qwen3-14b.
MODEL_LLAMA=meta-llama/Llama-3.1-8B-Instruct
MODEL_MISTRAL=mistralai/Mistral-7B-Instruct-v0.3
MODEL_QWEN=Qwen/Qwen2.5-7B-Instruct
MODEL_QWEN3_14B=Qwen/Qwen3-14B
LOCOMO_VLLM_MODEL=llama
LOCOMO_VLLM_API_KEY=token-abc123
LOCOMO_VLLM_TP=1
LOCOMO_VLLM_GPU_MEMORY_UTILIZATION=0.80
LOCOMO_VLLM_DTYPE=auto
VLLM_USE_FLASHINFER_SAMPLER=0

# Judge defaults. Use JUDGE_PROVIDER=vllm for a local vLLM server or none to skip judging.
JUDGE_PROVIDER=vllm
JUDGE_MODEL=google/gemma-2-9b-it
JUDGE_BASE_URL=http://127.0.0.1:8000/v1
JUDGE_API_KEY=token-abc123

# Mem0 fact inference. Both answer backends always retrieve inferred Mem0 facts.
# The provider is fixed to mem0's vllm provider, and the extraction model is
# always the answer model itself; scripts/extract_facts.sh spins up a vLLM
# server per answer model during setup. Fact-catalog identity includes this
# endpoint, so it must stay identical to what extract_facts.sh used
# (http://localhost:${MEM0_LLM_PORT:-8000}/v1). The api key is optional for
# local servers.
MEM0_LLM_BASE_URL=http://localhost:8000/v1
# MEM0_LLM_API_KEY=
MEM0_TELEMETRY=false
# Fact extraction uses a fixed 16384-token server context and bounded JSON
# output. scripts/extract_facts.sh rejects a conflicting context override.

# Embeddings. Required to populate caches with --preembed-only.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# Optional Hugging Face token for gated model downloads.
# HF_TOKEN=

# Keep local vLLM traffic off proxies.
NO_PROXY=localhost,127.0.0.1,::1
no_proxy=localhost,127.0.0.1,::1

# Benchmark defaults.
LOCOMO_LOG_EVERY=10

# Context window N counts the conversation turns immediately preceding each
# retrieved fact's source turn (crossing sessions). vllm-kv uses them as an
# encoding-only prefix whose KV is discarded; vllm-prefix renders the
# deduplicated turns in the prompt. 0 keeps both backends token-identical.
LOCOMO_KV_CONTEXT_WINDOW=0

# Standalone RAG benchmark (rag-jasper-bench). Datasets: multihoprag, qasper.
# Embeddings reuse OPENAI_API_KEY / OPENAI_EMBEDDING_MODEL above and judging
# reuses the JUDGE_* values above. The RAG context window counts preceding
# same-document chunks used as an encoding-only prefix (vllm-kv only).
# At answer time the full corpus chunk KV is loaded into host RAM (cpu store);
# --estimate-only prints the required host RAM per model.
# The scripts/rag stage scripts loop over RAG_DATASETS; models default per
# dataset (qasper's corpus-wide KV needs ~110 GiB host RAM with qwen but
# ~250 GiB with llama). The legacy single-dataset RAG_DATASET is still
# honored by the scripts and remains the default for direct CLI invocations.
RAG_DATASETS="multihoprag qasper"
# RAG_MODELS_MULTIHOPRAG=llama
# RAG_MODELS_QASPER=qwen
RAG_CHUNK_SIZE=1024
RAG_CONTEXT_WINDOW=5
RAG_TOP_K=15
# MULTIHOP_RAG_DATA_DIR=data/multihoprag
# RAG_KV_CHUNK_CACHE_ROOT=/path/to/rag-kv-chunks
LOCOMO_KV_BLOCK_SIZE=16
# Opt in to Jasper CUDA-result mapping and packed GPU chunk selection for the
# throughput kv_injection condition. The ordinary SearchHit path remains the
# default and can also be forced with --no-jasper-device-kv-selection.
LOCOMO_JASPER_DEVICE_KV_SELECTION=0
