{
  "benchmark": "memory-accuracy-latency",
  "model": "qwen",
  "dataset_path": "data/locomo10.json",
  "answer_backend": "kv-injection",
  "vector_backend": "jasper",
  "top_k": 50,
  "context_window": 0,
  "max_samples": 10,
  "max_questions": null,
  "log_every": 1,
  "log_level": "INFO",
  "preembed_workers": 4,
  "embedding_cache_enabled": true,
  "kv_chunk_cache_enabled": true,
  "skip_judge": false,
  "inferscale": {
    "engine": {
      "gpu_memory_utilization": 0.4,
      "max_model_len": 32768,
      "block_size": 16,
      "enable_prefix_caching": true,
      "connector_module": "inferscale.v1.kv.connector"
    },
    "kv": {
      "dtype": "bfloat16",
      "device": "cuda:0",
      "max_position": 32768,
      "store_backend": "gpu",
      "staging_slots": 4
    },
    "index": {
      "n_neighbors": 64,
      "alpha": 1.0,
      "workspace_budget": "10GB",
      "beam_width": 64
    },
    "embedding": {
      "model": "text-embedding-3-small",
      "base_url": null,
      "batch_size": 128
    },
    "generation": {
      "max_tokens": 512,
      "temperature": 0.0,
      "top_p": 1.0
    }
  },
  "mem0": {
    "llm_base_url": "http://localhost:8000/v1"
  },
  "extraction": {
    "port": 8000,
    "workers": 4,
    "gpu_memory_utilization": 0.85,
    "health_timeout_s": 900,
    "structured_outputs": {"backend": "xgrammar", "disable_any_whitespace": true},
    "extra_vllm_args": []
  },
  "judge": {
    "provider": "vllm",
    "max_tokens": 4,
    "with_evidence": false
  },
  "sweeps": {
    "standard": {
      "log_dir_prefix": "sweep-logs",
      "top_k": [5, 10, 20, 50],
      "variants": [
        {"name": "kv", "answer_backend": "kv-injection", "vector_backend": "jasper", "kv_store_backend": "gpu", "context_window": [0, 5, 20, 50]},
        {"name": "prefix", "answer_backend": "prompt-injection", "vector_backend": "qdrant", "kv_store_backend": "gpu", "context_window": [0]}
      ]
    },
    "cpu-store": {
      "log_dir_prefix": "sweep-cpu-logs",
      "top_k": [5, 10, 20, 50],
      "variants": [
        {"name": "kvcpu", "answer_backend": "kv-injection", "vector_backend": "jasper", "kv_store_backend": "cpu", "kv_staging_slots": 4, "context_window": [0, 5, 20, 50]}
      ]
    }
  }
}
