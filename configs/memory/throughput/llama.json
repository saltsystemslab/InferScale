{
  "benchmark": "memory-throughput",
  "model": "llama",
  "dataset_path": "data/locomo10.json",
  "conditions": [
    "mem0_qdrant",
    "kv_injection"
  ],
  "user_counts": [
    10,
    25,
    50,
    75,
    100
  ],
  "requests_per_user": 2,
  "max_output_tokens": 50,
  "warmup_batches": 2,
  "top_k": 50,
  "context_window": 50,
  "seed": 42,
  "log_level": "INFO",
  "embedding_cache_enabled": true,
  "kv_chunk_cache_enabled": true,
  "inferscale": {
    "engine": {
      "gpu_memory_utilization": 0.5,
      "max_model_len": 32768,
      "block_size": 16,
      "enable_prefix_caching": true,
      "connector_module": "inferscale.v1.kv.connector"
    },
    "kv": {
      "dtype": "bfloat16",
      "device": "cuda:0",
      "max_position": 32768,
      "store_backend": "gpu",
      "staging_slots": 4
    },
    "index": {
      "n_neighbors": 64,
      "alpha": 1.0,
      "workspace_budget": "10GB",
      "beam_width": 64
    },
    "embedding": {
      "model": "text-embedding-3-small",
      "base_url": null
    }
  },
  "mem0": {
    "llm_base_url": "http://localhost:8000/v1"
  },
  "sweeps": {
    "standard": {
      "run_prefix": "throughput",
      "conditions": [
        "mem0_qdrant",
        "kv_injection"
      ],
      "kv_store_backend": "gpu"
    },
    "cpu-store": {
      "run_prefix": "throughput-cpu",
      "conditions": [
        "kv_injection"
      ],
      "kv_store_backend": "cpu",
      "kv_staging_slots": 4
    }
  }
}
